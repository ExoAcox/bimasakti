{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "es2023",
    "lib": [
      "ES2023",
      "DOM"
    ],
    "module": "esnext",
    "types": [
      "vite/client"
    ],
    "allowArbitraryExtensions": true,
    "skipLibCheck": true,
    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",
    /* Linting */
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true,
    /* Path Aliases */
    "paths": {
      "@components": [
        "./src/components"
      ],
      "@components/*": [
        "./src/components/*"
      ],
      "@constants": [
        "./src/constants"
      ],
      "@constants/*": [
        "./src/constants/*"
      ],
      "@scenes": [
        "./src/scenes"
      ],
      "@scenes/*": [
        "./src/scenes/*"
      ],
      "@function": [
        "./src/function"
      ],
      "@state": [
        "./src/state"
      ],
      "@types": [
        "./src/types"
      ],
      "@shaders": [
        "./src/shaders"
      ],
      "@shaders/*": [
        "./src/shaders/*"
      ]
    }
  },
  "include": [
    "src"
  ]
}